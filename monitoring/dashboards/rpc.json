{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" }
  ],
  "id": null,
  "uid": "torus-rpc",
  "title": "Torus - RPC Performance",
  "description": "RPC request throughput, error rates, and latency metrics for Torus hyperBFT.",
  "tags": ["torus", "rpc"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(torus_block_height, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "title": "Total RPC Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }] }
        }
      },
      "targets": [
        {
          "expr": "sum(torus_rpc_requests_total{instance=~\"$instance\"})",
          "legendFormat": "total"
        }
      ]
    },
    {
      "title": "RPC Error Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(torus_rpc_requests_total{status=\"error\",instance=~\"$instance\"}[5m])) / sum(rate(torus_rpc_requests_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "error rate"
        }
      ]
    },
    {
      "title": "RPC Requests by Method",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 },
          "color": { "mode": "palette-classic" },
          "unit": "ops"
        }
      },
      "targets": [
        {
          "expr": "sum by (method) (rate(torus_rpc_requests_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "title": "RPC Duration (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 5 },
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(torus_rpc_request_duration_seconds_bucket{instance=~\"$instance\"}[5m]))",
          "legendFormat": "p50 {{instance}}"
        },
        {
          "expr": "histogram_quantile(0.95, rate(torus_rpc_request_duration_seconds_bucket{instance=~\"$instance\"}[5m]))",
          "legendFormat": "p95 {{instance}}"
        },
        {
          "expr": "histogram_quantile(0.99, rate(torus_rpc_request_duration_seconds_bucket{instance=~\"$instance\"}[5m]))",
          "legendFormat": "p99 {{instance}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
